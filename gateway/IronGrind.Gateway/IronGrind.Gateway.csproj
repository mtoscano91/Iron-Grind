<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- IronGrind gateway: login, registration and zone routing (ADR-016). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IronGrind.Gateway</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Pinned 2026-11-06 (Authentication Story 004, ADR-016 Decision 7). Npgsql/Dapper are used from Stories 006/007. -->
  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IronGrind.Shared/IronGrind.Shared.csproj" />
  </ItemGroup>

</Project>
