<linker>
  <!--
    IL2CPP stripping: keep the server-only database libraries whole (ADR-006 Decision 2, Verification Required 2;
    ADR-012). This file only preserves assemblies that are already in a build. It does not bring the DLLs into
    a client build: their import settings (UNITY_SERVER || UNITY_EDITOR, explicitly referenced) keep them out.
    See docs/server-libraries.md.
  -->
  <assembly fullname="Npgsql" preserve="all" />
  <assembly fullname="Dapper" preserve="all" />
  <!--
    Types that only Dapper constructs or reads, through reflection (Character Persistence Story 014): no compiled code
    calls their constructors or property accessors, so managed stripping could remove them and the first query would
    fail at run time only.
  -->
  <assembly fullname="IronGrind.ServerLogic">
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/RecordRow" preserve="all" />
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/RecordParameters" preserve="all" />
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/IdParameters" preserve="all" />
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/PendingPurchaseRow" preserve="all" />
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/BeginPurchaseParameters" preserve="all" />
    <type fullname="IronGrind.CharacterPersistence.NpgsqlCharacterRecordStore/PurchaseKeyParameters" preserve="all" />
  </assembly>
</linker>
